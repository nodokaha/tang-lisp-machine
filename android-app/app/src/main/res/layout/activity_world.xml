<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/room_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="World viewer"
            android:textColor="@color/text_cream"
            android:textSize="16sp" />

        <Button
            android:id="@+id/openWorldButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/accent"
            android:textColor="@color/accent_text"
            android:text="Open .BIN" />
    </LinearLayout>

    <TextView
        android:id="@+id/worldInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="No world loaded yet. Open a .BIN written by (save …) on the board — HEAPIMG.BIN, W1.BIN, and friends."
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <!-- Heap map: amber = alive in the global env, blue-grey = used, dark = free. -->
    <org.tanglisp.companion.HeapGridView
        android:id="@+id/heapGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="amber = alive · blue-grey = used · dark = free"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/worldDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/console_bg"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:text="Tap a binding below to see its value."
        android:textColor="@color/console_text"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Bindings"
        android:textColor="@color/text_cream"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:id="@+id/bindingsBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
